---
import { Footer } from "~/components/Footer";

const { title, onePager } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Personal space of Gabor Juhasz" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#d97706" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={title} />
    <meta property="twitter:title" content={title} />
    <meta property="og:image" content="https://juhg.hu/seo.png" />
    <meta name="twitter:image" content="https://juhg.hu/seo.png" />
    <title>{title}</title>
    <style is:global>
      body {
        background: #faf9f6;
      }

      .prose {
        --tw-prose-bold: inherit;
        --tw-prose-links: #252525;
      }

      .document h1 {
        letter-spacing: -0.04em;
      }

      .document h1::after {
        content: "";
        display: block;
        width: 3rem;
        height: 3px;
        margin-top: 1rem;
        background: #b45309;
      }

      .document h2 {
        padding-bottom: 0.4rem;
        border-bottom: 1px solid #d6d3d1;
      }

      .document a:hover {
        color: #b45309;
      }

      @media print {
        @page {
          size: A4;
        }

        body {
          background: white;
        }
        astro-dev-toolbar {
          display: none !important;
        }

        body.one-pager {
          font-size: 13pt;
          line-height: 1.7;
        }

        body.one-pager .document {
          padding: 2rem;
        }

        body.one-pager h1 {
          margin-bottom: 0.8rem;
          font-size: 21pt;
        }

        body.one-pager h1::after {
          margin-top: 0.5rem;
        }

        body.one-pager h2 {
          margin-top: 1.4rem;
          margin-bottom: 0.5rem;
          font-size: 15pt;
          break-after: avoid;
        }

        body.one-pager p,
        body.one-pager ul {
          margin-top: 0.5rem;
          margin-bottom: 0.5rem;
        }

        body.one-pager li {
          margin-top: 0.25rem;
          margin-bottom: 0.25rem;
        }
      }
    </style>
  </head>
  <body
    class:list={["prose prose-lg prose-amber max-w-none text-pretty pt-[5vw] prose-a:decoration-amber-600 prose-a:underline-offset-4 prose-h1:tracking-tight prose-h2:tracking-tight prose-h1:text-2xl prose-h2:text-xl sm:prose-h1:text-3xl sm:prose-h2:text-2xl print:pt-0", { "one-pager": onePager }]}
  >
    <div class="document mx-auto max-w-3xl px-6 py-8 sm:px-8 sm:py-10">
      <slot />
    </div>
    {!onePager && <Footer />}
  </body>
</html>
